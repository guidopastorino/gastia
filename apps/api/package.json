{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "esbuild --bundle --outfile=./dist/index.mjs --format=esm --platform=node --target=node20 ./src/index.ts",
    "zip": "zip -j lambda.zip dist/index.mjs",
    "update": "aws lambda update-function-code --zip-file fileb://lambda.zip --function-name hello",
    "deploy": "run-s build zip update",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/aws-lambda": "^1.0.0",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.11",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "npm-run-all2": "^9.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
