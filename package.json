{
  "name": "gastia",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "setup": "pnpm install",
    "mobile": "pnpm --filter mobile start",
    "mobile:ios": "pnpm --filter mobile ios",
    "mobile:android": "pnpm --filter mobile android",
    "mobile:web": "pnpm --filter mobile web",
    "mobile:typecheck": "pnpm --filter mobile exec tsc --noEmit",
    "api:build": "pnpm --filter api build",
    "api:typecheck": "pnpm --filter api typecheck",
    "api:deploy": "pnpm --filter api run deploy"
  }
}
