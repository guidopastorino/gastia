# Supabase project URL and publishable (anon) key.
# Local: run `pnpm supabase:start` and copy the values from `pnpm supabase:status`.
# On a physical device, replace 127.0.0.1 with your computer's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat public SDK key. In development use the Test Store key (starts with "test_");
# never ship it in a release build. Without a key the app runs and every user is on the Free plan.
EXPO_PUBLIC_REVENUECAT_API_KEY=
