# Supabase project URL and publishable (anon) key.
# Local: run `pnpm supabase:start` and copy the values from `pnpm supabase:status`.
# On a physical device, replace 127.0.0.1 with your computer's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat public SDK key. In development use the Test Store key (starts with "test_");
# never ship it in a release build. Without a key the app runs and every user is on the Free plan.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Google Sign-In (OAuth client IDs from Google Cloud Console > Google Auth Platform > Clients).
# The Web client ID is required on both platforms: its ID token is what Supabase verifies.
# The iOS client ID is also used to build the iOS URL scheme in app.config.ts (rebuild after changing it).
# Android needs no ID here: its client is matched by package name + SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
